    {
      "type": "layout",
      "id": "w2z0e9flg16e",
      "x": 676,
      "y": 130,
      "w": 1048,
      "h": 616,
      "name": "Additional Features",
      "description": "Each track button allows you to switch modes. \n\n",
      "scope": [
        "screen",
        "track-1",
        "track-2",
        "track-3",
        "track-4",
        "left",
        "right",
        "up",
        "down"
      ],
      "controls": {
        "track-1": {
          "meta": {
            "label": "FM-1 Mode",
            "description": "Controls the FM1 using a mapping of FM-1's own keyboard to the pads"
          }
        },
        "track-2": {
          "meta": {
            "label": "MIDI Mode",
            "description": "Send MIDI notes to the FM-1 using the pads in a keyboard layout:\nIsomorphic in Scale\nIsomorphic Chromatic\nDrum\nOctave - Each Row is an Octave in scale\n\nWhile holding down the button you can use the 16 step buttons to select the MIDI Channel\n\nWhile holding down the different layouts appear on the pads. \n\nIn drum mode each key is mapped starting at C2 in lower right, but you can hold down on a pad and then once you use the jogwheel you can change the Note assigned to the key. "
          }
        },
        "track-3": {
          "meta": {
            "label": "Control Mode",
            "description": "This is like the MIDI Keyboard mode, except it also now takes over the knobs. \n\nEach knob becomes an assignable CC with 4 banks. These are assigned to defaults\n\nHold the track button down and turn a knob to change the CC\n\nTurn the jogwheel to change the CC banks. "
          }
        },
        "track-4": {
          "meta": {
            "label": "Sequencer Mode",
            "description": "Takes over the pads and also the sequencer keys:\nPads follow the same layout shared between midi mode. \nThis also includes the knobs from the Control mode. "
          }
        },
        "up": {
          "meta": {
            "label": "OCT Up",
            "description": "Only available in modes 2-4"
          }
        },
        "down": {
          "meta": {
            "label": "OCT Down"
          }
        }
      },
      "screen": ""
    },
