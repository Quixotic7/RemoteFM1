+/* the script's "wifi" (names: '_' for a space):
+ *   wifi clear                         no networks around
+ *   wifi add NAME RSSI SECURED CH [PASS]   a network around, after the others (the strongest first: add them so);
+ *                                      PASS: the only password it takes (none: any)
+ *   wifi keep NAME [PASS]              a network kept, to the front
+ *   wifi forget_all                    none kept
+ *   wifi pass_is TEXT                  the last password a join was given is TEXT (said ok / FAIL, never shown) */
+static void wf_name(char *d, const char *s)
+{
+    int i;
+    for (i = 0; i < 32 && s[i]; i++)
+        d[i] = s[i] == '_' ? ' ' : s[i];
+    d[i] = 0;
+}
+static int wifi_cmd(const char *a, const char *b, const char *c, const char *d, const char *line)
+{
+    char e[64] = {0};
+    if (!strcmp(a, "clear")) {
+        wf_nair = 0;
+    } else if (!strcmp(a, "add") && wf_nair < 12) {
+        wf_air_t *n = &wf_air[wf_nair++];
+        memset(n, 0, sizeof *n);
+        wf_name(n->ssid, b);
+        n->rssi = atoi(c);
+        n->secured = atoi(d);
+        if (sscanf(line, "%*s %*s %*s %*s %*s %d %63s", &n->ch, e) >= 1)
+            wf_cpy(n->pass, e, sizeof n->pass);
+    } else if (!strcmp(a, "keep")) {
+        char s[33];
+        wf_name(s, b);
+        wf_keep(s, c);
+    } else if (!strcmp(a, "forget_all")) {
+        memset(wf_kept, 0, sizeof wf_kept);
+        memset(wf_kpass, 0, sizeof wf_kpass);
+    } else if (!strcmp(a, "pass_is")) {
+        if (strcmp(wf_pass, b)) {
+            printf("FAIL wifi pass_is: the last join's password is not the one expected\n");
+            return 1;
+        }
+        printf("  ok   wifi pass_is\n");
+    } else {
+        printf("FAIL wifi %s: clear, add, keep, forget_all, pass_is\n", a);
+        return 1;
+    }
+    return 0;
+}
