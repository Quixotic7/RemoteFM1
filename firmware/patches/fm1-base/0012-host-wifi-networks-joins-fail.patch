+static void wf_keep(const char *ssid, const char *pass)   /* to the front; the oldest falls off */
+{
+    int i = wf_kept_find(ssid);
+    if (i < 0)
+        i = 5;
+    for (; i > 0; i--) {
+        memcpy(wf_kept[i], wf_kept[i - 1], sizeof wf_kept[0]);
+        memcpy(wf_kpass[i], wf_kpass[i - 1], sizeof wf_kpass[0]);
+    }
