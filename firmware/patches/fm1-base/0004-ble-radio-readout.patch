+/* what the computer's link negotiated, for an app to show (ble_midi_radio: a test build's readout) */
+static struct {
+    u16 interval, latency, timeout, mtu;         /* 1.25 ms, events, 10 ms; the ATT MTU (0: no exchange yet) */
+    u16 tx_oct, tx_us, rx_oct, rx_us;            /* the last data length change (0: none, 27 / 328) */
+    u8 tx_phy, rx_phy, phy_status, n_dl, n_phy, n_conn_upd, param_ok, param_refused;
+} radio;
+static void radio_reset(void)
+{
+    memset(&radio, 0, sizeof radio);
+    radio.phy_status = radio.param_ok = 0xFF;
+}
+/* ble_midi_radio(b): 40 bytes, little-endian: 'R', 1 (the layout), what this build asks (bit 0 the data length, 1 the
+ * 2M PHY, 2 the 7.5 ms interval), the controller's receive buffers, then the link as negotiated: interval (1.25 ms),
+ * latency, timeout (10 ms), ATT MTU, the last data length change (tx octets, tx us, rx octets, rx us; 0 = none), tx
+ * PHY, rx PHY (1 1M, 2 2M, 3 coded; 0 = no update), the PHY update's status (FF none), data length changes, PHY
+ * updates, connection updates, the request accepted (its row; FF none), requests refused, linked (1), the Bluetooth
+ * heap's most ever and its size (u32 each), the controller's packet length, which of this build's asks went (bits) */
+void ble_midi_radio(u8 *b)
+{
+    extern const int config_btctler_le_rx_nums, config_btctler_le_acl_packet_length;
+    extern uint32_t shim_heap_peak;
+    extern const uint32_t shim_heap_size;
+    u16 w[8] = {radio.interval, radio.latency, radio.timeout, radio.mtu, radio.tx_oct, radio.tx_us, radio.rx_oct,
+                radio.rx_us};
+    u32 i, h[2] = {shim_heap_peak, shim_heap_size};
+    memset(b, 0, 40);
+    b[0] = 'R';
+    b[1] = 1;
+    b[2] = (u8)(BLE_MIDI_DLE | BLE_MIDI_2M << 1 | BLE_MIDI_FAST_CI << 2);
+    b[3] = (u8)config_btctler_le_rx_nums;
+    for (i = 0; i < 8; i++) {
+        b[4 + 2 * i] = (u8)w[i];
+        b[5 + 2 * i] = (u8)(w[i] >> 8);
+    }
+    b[20] = radio.tx_phy;
+    b[21] = radio.rx_phy;
+    b[22] = radio.phy_status;
+    b[23] = radio.n_dl;
+    b[24] = radio.n_phy;
+    b[25] = radio.n_conn_upd;
+    b[26] = radio.param_ok;
+    b[27] = radio.param_refused;
+    b[28] = con_handle != 0;
+    for (i = 0; i < 8; i++)
+        b[29 + i] = (u8)(h[i / 4] >> (8 * (i % 4)));
+    b[37] = (u8)config_btctler_le_acl_packet_length;
+    b[38] = radio_asked;
+}
 static void connection_update_complete_success(u8 *packet)
 {
     int conn_interval = hci_subevent_le_connection_update_complete_get_conn_interval(packet);
     int conn_latency = hci_subevent_le_connection_update_complete_get_conn_latency(packet);
     int conn_timeout = hci_subevent_le_connection_update_complete_get_supervision_timeout(packet);
     printf("conn: interval %d latency %d\n", conn_interval, conn_latency);   /* 1.25 ms units, on the log */
+    radio.interval = (u16)conn_interval;
+    radio.latency = (u16)conn_latency;
+    radio.timeout = (u16)conn_timeout;
+    radio.n_conn_upd++;
 }
 
