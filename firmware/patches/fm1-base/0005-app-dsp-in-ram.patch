-    rt_calls = [ln for ln in rt.splitlines() if re.search(r"\bcall\b", ln) and not in_c1(ln) and not in_ar(ln)]
+    # RAM code may call RAM code: a direct call whose target is in RAM, or an indirect one (an app's DSP calls through
+    # function pointers: saadet's FM6) when the RAM code takes the address of no function in the flash. What is left
+    # could reach the flash (the second core's loop and the app's .app_ram aside)
+    rt_lo, rt_hi = (lambda a, b: (int(a.group(1), 16), int(b.group(1), 16)) if a and b else (0, 0))(
+        re.search(r"^([0-9a-f]+) .*\s_rt_start$", syms, re.M), re.search(r"^([0-9a-f]+) .*\s_rt_end$", syms, re.M))
