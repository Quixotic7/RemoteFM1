+static uint32_t lv_keys[2], lv_8[2];   /* plat_lights_levels' keys and levels: "leds" shows them as the glow */
+void plat_lights_levels(uint32_t ka, uint32_t a8, uint32_t kb, uint32_t b8)
+{
+    lv_keys[0] = ka & ~lit_keys;
+    lv_keys[1] = kb & ~lit_keys & ~ka;
+    lv_8[0] = a8, lv_8[1] = b8;
+}
 static int glow_on = 1;                 /* the device's button glow (plat_glow) */
 void plat_glow(int on) { glow_on = on; }
 void plat_play_red(int red) { (void)red; }      /* the device's PLAY colour: green, red while recording */
