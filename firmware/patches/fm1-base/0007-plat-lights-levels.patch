+void plat_lights_levels(uint32_t ka, uint32_t a8, uint32_t kb, uint32_t b8)   /* felucca-bsp's fm1_led_lv */
+{
+    uint8_t l[2][FM1_NCOL] = {{0}};
+    uint32_t i, c, j;
+    for (j = 0; j < 2u; j++)
+        for (i = 0; i < NKEYS; i++) {
+            uint8_t q = led_pos[14u + i];
+            if (q != 0xFF && ((j ? kb : ka) >> i & 1u))
+                l[j][q >> 3] |= (uint8_t)(1u << (q & 7u));
+        }
+    fm1_led_levels(a8, b8);
+    for (c = 0; c < FM1_NCOL; c++) {
+        fm1_led_lv[0][c] = (uint8_t)(l[0][c] & ~fm1_led[c]);
+        fm1_led_lv[1][c] = (uint8_t)(l[1][c] & ~fm1_led[c] & ~l[0][c]);
+    }
 }
 static uint8_t glow_on = 1, play_red;
 void plat_glow(int on) { glow_on = (uint8_t)(on != 0); }
