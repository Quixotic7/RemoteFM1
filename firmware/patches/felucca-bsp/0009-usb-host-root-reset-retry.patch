+static void test_slow_device(void)
+{
+    /* a device that answers only 300 ms after a reset (one serving USB from a slow timer): the third reset's
+     * 400 ms recovery finds it; no more resets after that */
+    connect(KBD);
+    answer_after = 300;
+    host_on();
+    assert(enumerate() && uh.msg == UH_MSG_MIDI && root_resets == 3);
+    uh.msg = 0;
+    usb_host_switch(0); usb_host_task(fm1_ms); uh.msg = 0;
+    /* one that never answers: five resets, then it waits for unplug; nothing said (it is not NO MIDI) */
+    connect(KBD);
+    answer_after = ~0u;
+    host_on();
+    uint32_t t0 = fm1_ms;
+    assert(!enumerate() && uh.msg == UH_MSG_NONE && root_resets == UH_ROOT_TRIES && uh.tried);
+    assert(fm1_ms - t0 >= 5u * 50u + 3100u);
+    for (int k = 0; k < 100; k++) { fm1_ms += 20; usb_host_task(fm1_ms); }
+    assert(root_resets == UH_ROOT_TRIES && !uh.msg);
+    /* a device that answers at once without MIDI: one reset, NO MIDI */
+    usb_host_switch(0); usb_host_task(fm1_ms); uh.msg = 0;
+    connect(STICK);
+    host_on();
+    assert(!enumerate() && uh.msg == UH_MSG_NOMIDI && root_resets == 1);
+    usb_host_switch(0); usb_host_task(fm1_ms); uh.msg = 0;
+    puts("USB host: a slow device found by a later reset, a silent one reset 5 times and not called NO MIDI: OK");
+}
