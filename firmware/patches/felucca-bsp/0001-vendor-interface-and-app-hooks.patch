+#if FELUCCA_VENDOR
+static void vb_ep3_rx(void)                             /* leaves the packet (NAK) while the ring is too full */
+{
+    uint32_t csr, n, i, w;
+    sie_wr(S_INDEX, 3);
+    csr = sie_rd(S_RXCSR1) | (sie_rd(S_RXCSR2) << 8);
+    if (!(csr & 1u)) {
+        vb.rx_pend = 0;
+        return;
+    }
+    n = sie_rd(S_RXCOUNT1) | (sie_rd(S_RXCOUNT2) << 8);
+    if (n > 64u)
+        n = 64u;
+    if (FELUCCA_VENDOR_IN_N - (vi_w - vi_r) < n) {
+        vb.held++;
+        return;                                         /* rx_pend stays: taken on a later poll */
+    }
+    vb.rx_pend = 0;
+    fm1_usb_rx_sync();
+    w = vi_w;
+    for (i = 0; i < n; i++)
+        vb_in[(w + i) & (FELUCCA_VENDOR_IN_N - 1u)] = ep3rx[i];
+    RING_PUBLISH();
+    vi_w = w + n;
+    vb.rx_pkts++;
+    csr = (csr & ~0x164u) | 0x10u;
+    sie_wr(S_RXCSR1, csr & 0xFFu);
+    sie_wr(S_RXCSR2, csr >> 8);
+}
+
+/* one packet of up to 64 bytes; when the ring would empty with exactly 64, 63 go now and the last byte in a short
+ * packet after: a burst always ends in a short packet, which ends the host's transfer (no ZLP needed) */
+static void vb_ep3_tx(void)
+{
+    uint32_t csr, n, i, r = vo_r, avail = vo_w - r;
+    if (!avail)
+        return;
+    sie_wr(S_INDEX, 3);
+    csr = sie_rd(S_TXCSR1);
+    if (csr & 0x01u)
+        return;                                         /* the previous packet still waits */
+    if (csr & 0x80u)
+        sie_wr(S_TXCSR1, csr & ~0x80u);
+    n = avail > 64u ? 64u : avail == 64u ? 63u : avail;
+    RING_PUBLISH();                                     /* the slots after the index */
+    for (i = 0; i < n; i++)
+        ep3tx[i] = vb_out[(r + i) & (FELUCCA_VENDOR_OUT_N - 1u)];
+    RING_PUBLISH();
+    vo_r = r + n;
+    fm1_usb_ep_send(3, ep3tx, n);
+    sie_wr(S_TXCSR1, sie_rd(S_TXCSR1) | 0x01u);
+    vb.tx_pkts++;
+}
+
+/* the app's side (main loop): bytes from the host, waiting; take up to n; room to send; a whole message out (a, then
+ * b: a header and a body), all of it or nothing: 1 queued, 0 no room now, -1 no host */
+static uint32_t usb_vendor_avail(void) { return vi_w - vi_r; }
+static uint32_t usb_vendor_read(uint8_t *dst, uint32_t n)
+{
+    uint32_t r = vi_r, i, k = vi_w - r;
+    if (k > n)
+        k = n;
+    RING_PUBLISH();
+    for (i = 0; i < k; i++)
+        dst[i] = vb_in[(r + i) & (FELUCCA_VENDOR_IN_N - 1u)];
+    RING_PUBLISH();
+    vi_r = r + k;
+    return k;
+}
+static uint32_t usb_vendor_room(void) { return usb.config ? FELUCCA_VENDOR_OUT_N - (vo_w - vo_r) : 0u; }
+static int usb_vendor_send(const uint8_t *a, uint32_t na, const uint8_t *b, uint32_t nb)
+{
+    uint32_t w = vo_w, i;
+    if (!usb.up || !usb.config)
+        return -1;
+    if (FELUCCA_VENDOR_OUT_N - (w - vo_r) < na + nb)
+        return 0;
+    for (i = 0; i < na; i++)
+        vb_out[(w + i) & (FELUCCA_VENDOR_OUT_N - 1u)] = a[i];
+    w += na;
+    for (i = 0; i < nb; i++)
+        vb_out[(w + i) & (FELUCCA_VENDOR_OUT_N - 1u)] = b[i];
+    RING_PUBLISH();
+    vo_w = w + nb;
+    return 1;
+}
