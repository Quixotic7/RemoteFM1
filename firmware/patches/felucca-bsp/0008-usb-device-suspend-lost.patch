--- a/tests/usb_host_test.c
+++ b/tests/usb_host_test.c
@@ -1101,6 +1101,29 @@ static void test_device_mode_untouched(void)
     puts("USB host: off at boot, the device side starts as before: OK");
 }
 
+static void test_device_suspend_lost(void)
+{
+    /* a configured device's bus suspends (the computer asleep, the cable pulled): its notes are released */
+    connect(KBD);
+    usb_start();
+    usb.config = 1;
+    usb.suspended = 0;
+    midi_usb_lost = 0;
+    common[S_INTRUSB] = 0x01u;                          /* suspend */
+    usb_poll();
+    assert(usb.suspended && midi_usb_lost);
+    midi_usb_lost = 0;
+    usb_poll();                                         /* (still suspended: once) */
+    assert(!midi_usb_lost);
+    usb.config = 0;                                     /* not configured: nothing was held */
+    usb.suspended = 0;
+    usb_poll();
+    assert(usb.suspended && !midi_usb_lost);
+    common[S_INTRUSB] = 0;
+    usb.up = usb.suspended = 0;
+    puts("USB device: a configured port's suspend releases the host's notes (midi_usb_lost): OK");
+}
+
 static void test_mode_lifecycle(void)
 {
     connect(KBD);
