--- a/chip/usb_host.c
+++ b/chip/usb_host.c
@@ -356,6 +356,26 @@ static void uh_host_up(void)
     uh.hub_addr = 0;
 }
 
+/* host -> device: undo what host mode wrote and the device driver never writes, before the port is switched off: the
+ * session and host request (DEVCTL), EP1's transfer types, intervals and TX mode, the function address, a bus reset
+ * left asserted, a packet of the device's left in EP1's FIFO. Without it the computer saw nothing on the port after
+ * the host was switched off until a power cycle (ChoralRoot on an FM-1): the SIE's reset line (fm1_usb_reset) alone
+ * may not clear the OTG block's host state */
+static void uh_host_down(void)
+{
+    sie_wr(S_DEVCTL, 0);
+    sie_wr(S_INDEX, 1);
+    sie_wr(S_TXTYPE, 0);
+    sie_wr(S_TXINTERVAL, 0);
+    sie_wr(S_RXTYPE, 0);
+    sie_wr(S_RXINTERVAL, 0);
+    sie_wr(S_TXCSR2, 0);
+    sie_wr(S_RXCSR1, 0x10u);                            /* (flush) */
+    sie_wr(S_INDEX, 0);
+    sie_wr(S_FADDR, 0);
+    sie_wr(S_POWER, 0);
+}
+
 /* a device is on the line: reset the bus and find the MIDI endpoint */
 static void uh_connect(void)
 {
@@ -429,8 +449,10 @@ static void usb_host_task(uint32_t now)
         } else {
             uh.on = 0;
             RING_PUBLISH();
+            uh_host_down();
             fm1_usb_off();
-            usb_retry_ms = now - 1000u;                 /* usb_retry makes the port a device again at once */
+            usb_retry_ms = now;                         /* usb_retry makes the port a device a second later: off
+                                                         * the bus that long, a computer sees a clean attach */
             uh.msg = UH_MSG_OFF;
         }
         return;
