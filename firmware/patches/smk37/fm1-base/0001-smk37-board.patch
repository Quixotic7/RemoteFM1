+++ b/device/smk_panel.c
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: MPL-2.0
+ * Copyright (C) 2026 RemoteFM1 contributors */
+/* The M-VAVE SMK-37's panel as an FM-1's (BOARD_SMK37): plat.h's buttons, keys, encoders and lights on the SMK's
+ * controls, and the controls the FM-1 has not as plat_smk_take's changes. The same code on the device (plat_smk37.c,
+ * the scan's state) and in the host simulator (host/plat_host.c, the script's), so the simulator's tests are the
+ * device's mapping. Part of the unity build (device/unity.c; host/plat_host.c), after plat.h and felucca-bsp's
+ * boards/smk37/smk_decode.h; the platform gives it smk_raw_get.
+ *
+ *   keys      keybed keys 5..31 (F3..G5) are the FM-1's 27, with their velocity; the 10 outer ones (C3..E3, G#5..C6)
+ *             are changes (PLAT_SMK_KEY)
+ *   pads      the FM-1's 16 white keys (F3 G3 ... F5 G5) in reading order: the top row white keys 1..8, the bottom
+ *             row 9..16 (hardware pads 0..7 and 8..15: the guide's 6.3); a hit presses the key at the pad's velocity,
+ *             and the pad shows that key's light. A key is held while its pad or its keybed key is; its velocity is
+ *             its last press's
+ *   buttons   the 2 x 6 grid as the FM-1's, by place: top row ARP FX, NOTE REPEAT SEL, SCALE ENV, CHORD LFO,
+ *             GLOBE EDIT, BT GLO; bottom row PATCH HOME, PARA SAVE, FX ARP, SEQ SEQ, SEQ PLAY PLAY, SEQ REC REC;
+ *             OCTAVE- / + OCT- / OCT+; < and > turn SELECT a detent each press; KNOB BANK and FADER BANK are
+ *             changes (PLAT_SMK_BTN)
+ *   knobs     K1 MASTER (the platform's virtual pot), K2 SELECT, K3 ALGORITHM, K4 PRESETS, K5..K8 KNOB 1..4
+ *   faders    KNOB 1..4 too, up clockwise, from the first reading on (no turn from where a fader was at the start):
+ *             plat_smk_faders sets how. TURN4 (the start) a detent every 4 steps, TURN1 a detent a step, ABS no turn,
+ *             a fader's position instead (PLAT_SMK_FADER)
+ *   lights    a button's LED lit while the FM-1's is lit (the SMK's are on or off: the FM-1's dim glow and its mid
+ *             level do not show); SEQ PLAY's two halves are PLAY's red and green; a pad at its white key's level
+ *             (lit, the two steady levels, the mid level, the glow), in the warm white of the FM-1's key LEDs
+ *   the rest  the pitch wheel -8192..8191, the mod wheel 0..127, the pedal down / up: changes */
+
+static const uint8_t SMK_BTN_OF_LABEL[NB] = {                /* plat.h's B_* -> the SMK's button */
+    SMK_B_ARP, SMK_B_NOTE_REPEAT, SMK_B_SCALE, SMK_B_CHORD, SMK_B_GLOBE, SMK_B_BT, SMK_B_PATCH, SMK_B_PARA,
+    SMK_B_FX, SMK_B_SEQ, SMK_B_PLAY, SMK_B_REC, SMK_B_OCT_DN, SMK_B_OCT_UP};
+static const uint8_t SMK_ENC_OF_ROLE[NE] = {1, 2, 3, 4, 5, 6, 7};   /* EN_* -> K2..K8 (K1 is MASTER) */
+#define SMK_ENC_MASTER 0u
+#define SMK_MASTER_STEP 96                                    /* MASTER's position (0..4096) a detent of K1 */
+static const uint8_t SMK_WHITE_K[16] = PLAT_WHITE_KEYS;       /* white key w (= the pad in reading order) -> key */
+static const uint8_t SMK_EXTRA_BTN[2] = {SMK_B_KNOB_BANK, SMK_B_FADER_BANK};
+_Static_assert(PLAT_SMK_KNOB_BANK == 0 && PLAT_SMK_FADER_BANK == 1, "plat.h's extra buttons in SMK_EXTRA_BTN's order");
+#define SMK_PAD_RGB 0xFFE6A8u                                 /* the FM-1's key LEDs' warm white */
+#define SMK_PAD_LIT 72u                                       /* a lit pad's brightness, /255 of the LEDs' full */
+
+/* the board's state now (device: the scan's; host: the script's) */
+typedef struct {
+    uint32_t keys[2];                                         /* keybed: bit k of keys[k >> 5] */
+    uint8_t key_vel[SMK_NKEY];
+    uint16_t pads;                                            /* bit p: hardware pad p held */
+    uint8_t pad_vel[SMK_NPAD];
+    uint32_t btns;                                            /* SMK_B_* held */
+    uint8_t fader[SMK_NFADER], mod, pedal;
+    uint8_t fader_ok;                                         /* bit f: fader f read at least once */
+    int16_t bend;
+} smk_raw_t;
+static void smk_raw_get(smk_raw_t *r);
+
+static struct {
+    smk_raw_t was;                                            /* the state the last poll saw */
+    uint32_t kb, pad;                                         /* the FM-1's keys held by the keybed, by the pads */
+    uint8_t vel[NKEYS];                                       /* each FM-1 key's last press */
+    uint16_t q[32];                                           /* outer keys and extra buttons: kind << 14 | id << 7 | v */
+    uint8_t qw, qr;
+    uint8_t dirty;                                            /* bit 0 bend, 1 mod, 2 pedal, 3..6 faders 0..3 */
+    uint8_t started;
+    uint8_t fader_base;                                       /* bit f: fader f's position known */
+    uint8_t fader_mode;                                       /* plat_smk_faders: PLAT_SMK_FADERS_* */
+    uint8_t fader_q[SMK_NFADER];                              /* each fader's detent of 4 steps (TURN4), in every mode */
+    int32_t enc[NE];                                          /* turns from < > and the faders, by EN_* */
+} smk_pn;
+
+static uint32_t smk_fm1_buttons(uint32_t smk)                /* the SMK's buttons -> plat.h's B_* */
+{
+    uint32_t b = 0, i;
+    for (i = 0; i < NB; i++)
+        if (smk >> SMK_BTN_OF_LABEL[i] & 1u)
+            b |= 1u << i;
+    return b;
+}
+
+static void smk_q_put(uint32_t kind, uint32_t id, uint32_t v)
+{
+    if ((uint8_t)(smk_pn.qw - smk_pn.qr) >= 32u)
+        return;                                               /* (full: dropped; a key's release is never lost
+                                                               * behind a press within 32) */
+    smk_pn.q[smk_pn.qw++ & 31u] = (uint16_t)(kind << 14 | id << 7 | (v & 0x7Fu));
+}
+
+/* position p's detent of 4 steps, from q, the one it was at: a step of hysteresis each side, so a fader resting on
+ * an edge (the scan's filter lets it move 2 steps) does not flicker between two */
+static uint32_t smk_fader_q(uint32_t q, uint32_t p)
+{
+    if (p > 4u * q + 4u)
+        return (p - 1u) >> 2;
+    if (p + 1u < 4u * q)
+        return (p + 1u) >> 2;
+    return q;
+}
+
+/* the faders as KNOB 1..4: the change since the last poll, as turns (TURN4: of the detents, TURN1: of the steps) or
+ * the position (ABS, as a change); a fader's first reading only sets where it is (the scan's filter already holds a
+ * fader at rest steady) */
+static void smk_panel_faders(const smk_raw_t *r)
+{
+    uint32_t i, q;
+    for (i = 0; i < SMK_NFADER; i++) {
+        if (!(r->fader_ok >> i & 1u))
+            continue;
+        if (!(smk_pn.fader_base >> i & 1u)) {
+            smk_pn.fader_base |= (uint8_t)(1u << i);
+            smk_pn.fader_q[i] = (uint8_t)(r->fader[i] >> 2);
+            continue;
+        }
+        if (r->fader[i] == smk_pn.was.fader[i])
+            continue;
+        q = smk_fader_q(smk_pn.fader_q[i], r->fader[i]);
+        if (smk_pn.fader_mode == PLAT_SMK_FADERS_ABS)
+            smk_pn.dirty |= (uint8_t)(8u << i);
+        else if (smk_pn.fader_mode == PLAT_SMK_FADERS_TURN1)
+            smk_pn.enc[EN_K1 + i] += (int32_t)r->fader[i] - (int32_t)smk_pn.was.fader[i];
+        else
+            smk_pn.enc[EN_K1 + i] += (int32_t)q - (int32_t)smk_pn.fader_q[i];
+        smk_pn.fader_q[i] = (uint8_t)q;
+    }
+}
+
+/* the state again: the FM-1's keys (and each one's velocity at its press), the changes of the rest */
+static void smk_panel_poll(void)
+{
+    smk_raw_t r;
+    uint32_t kb = 0, pad = 0, k, i;
+    smk_raw_get(&r);
+    for (k = 0; k < NKEYS; k++)
+        if (r.keys[(SMK_KEY_F3 + k) >> 5] >> ((SMK_KEY_F3 + k) & 31u) & 1u)
+            kb |= 1u << k;
+    for (i = 0; i < 16u; i++)
+        if (r.pads >> i & 1u)
+            pad |= 1u << SMK_WHITE_K[i];
+    for (k = 0; k < NKEYS; k++) {                             /* a press, from either: its velocity */
+        uint32_t m = 1u << k;
+        if ((kb & m) && !(smk_pn.kb & m))
+            smk_pn.vel[k] = r.key_vel[SMK_KEY_F3 + k];
+        if ((pad & m) && !(smk_pn.pad & m)) {
+            for (i = 0; i < 16u && SMK_WHITE_K[i] != k; i++)
+                ;
+            smk_pn.vel[k] = r.pad_vel[i];
+        }
+    }
+    smk_pn.kb = kb;
+    smk_pn.pad = pad;
+    if (!smk_pn.started) {                                    /* (the first look: what is held starts nothing) */
+        smk_pn.started = 1;
+        smk_pn.was = r;
+        smk_pn.dirty = 0;
+        return;
+    }
+    for (k = 0; k < SMK_NKEY; k++) {                          /* the outer keys */
+        uint32_t on = r.keys[k >> 5] >> (k & 31u) & 1u, was = smk_pn.was.keys[k >> 5] >> (k & 31u) & 1u;
+        if ((k < SMK_KEY_F3 || k >= SMK_KEY_F3 + NKEYS) && on != was)
+            smk_q_put(PLAT_SMK_KEY, k, on ? r.key_vel[k] : 0u);
+    }
+    for (i = 0; i < 2u; i++) {
+        uint32_t b = SMK_EXTRA_BTN[i], on = r.btns >> b & 1u;
+        if (on != (smk_pn.was.btns >> b & 1u))
+            smk_q_put(PLAT_SMK_BTN, i, on);
+    }
+    if ((r.btns & ~smk_pn.was.btns) >> SMK_B_LEFT & 1u)       /* < and >: SELECT a detent a press */
+        smk_pn.enc[EN_SELECT]--;
+    if ((r.btns & ~smk_pn.was.btns) >> SMK_B_RIGHT & 1u)
+        smk_pn.enc[EN_SELECT]++;
+    smk_panel_faders(&r);
+    if (r.bend != smk_pn.was.bend)
+        smk_pn.dirty |= 1u << 0;
+    if (r.mod != smk_pn.was.mod)
+        smk_pn.dirty |= 1u << 1;
+    if (r.pedal != smk_pn.was.pedal)
+        smk_pn.dirty |= 1u << 2;
+    smk_pn.was = r;
+}
+
+static uint32_t smk_fm1_keys(void) { return smk_pn.kb | smk_pn.pad; }
+static int32_t smk_panel_enc(int role)                        /* EN_*'s turns from < > and the faders, taken */
+{
+    int32_t v;
+    smk_panel_poll();
+    v = smk_pn.enc[role];
+    smk_pn.enc[role] = 0;
+    return v;
+}
+static uint8_t smk_fm1_vel(uint32_t k) { return k < NKEYS && smk_pn.vel[k] ? smk_pn.vel[k] : 100u; }
+
+void plat_smk_faders(int mode)
+{
+    uint32_t i;
+    if (mode == smk_pn.fader_mode)
+        return;
+    smk_panel_poll();                                         /* (what moved till now in the old way; from here on
+                                                               * the new one, from where each fader is) */
+    smk_pn.fader_mode = (uint8_t)mode;
+    smk_pn.dirty &= (uint8_t)~0x78u;                          /* no stale position, */
+    for (i = 0; i < SMK_NFADER; i++)
+        smk_pn.enc[EN_K1 + i] = 0;                            /* nor turns still to take */
+}
+
+int plat_smk_take(plat_smk_ev_t *e)
+{
+    uint32_t i;
+    smk_panel_poll();
+    if (smk_pn.qr != smk_pn.qw) {
+        uint32_t x = smk_pn.q[smk_pn.qr++ & 31u];
+        e->type = (uint8_t)(x >> 14);
+        e->id = (uint8_t)(x >> 7 & 0x7Fu);
+        e->v = (int16_t)(x & 0x7Fu);
+        return 1;
+    }
+    for (i = 0; i < 3u; i++)
+        if (smk_pn.dirty >> i & 1u) {
+            smk_pn.dirty &= (uint8_t)~(1u << i);
+            e->id = 0;
+            e->type = (uint8_t)(i == 0u ? PLAT_SMK_BEND : i == 1u ? PLAT_SMK_MOD : PLAT_SMK_PEDAL);
+            e->v = (int16_t)(i == 0u ? smk_pn.was.bend : i == 1u ? smk_pn.was.mod : smk_pn.was.pedal);
+            return 1;
+        }
+    for (i = 0; i < SMK_NFADER; i++)
+        if (smk_pn.dirty >> (3u + i) & 1u) {
+            smk_pn.dirty &= (uint8_t)~(8u << i);
+            e->type = PLAT_SMK_FADER;
+            e->id = (uint8_t)i;
+            e->v = smk_pn.was.fader[i];
+            return 1;
+        }
+    return 0;
+}
+int plat_smk_level(int type)                                  /* where a wheel or the pedal is now */
+{
+    smk_raw_t *w = &smk_pn.was;
+    return type == PLAT_SMK_BEND ? w->bend : type == PLAT_SMK_MOD ? w->mod : type == PLAT_SMK_PEDAL ? w->pedal : 0;
+}
+
+/* --------------------------------------------------------------- lights --- */
+static uint32_t smk_led_lit;                                  /* the SMK's LEDs (bit i: LED i, smk_input.h) */
+static uint32_t smk_pad_rgb[SMK_NPAD];                        /* 0xRRGGBB a pad */
+static uint8_t smk_pad_lvl[SMK_NPAD];                         /* its level /255 of lit (the simulator's view) */
+static uint8_t smk_lights_dirty = 3;                    /* (the first frame goes out: the pads dark, whatever was on them) */
+static struct {
+    uint32_t b, k, db, dk, mb, mk, la, lb;
+    uint8_t a8, b8;
+    int glow;
+} smk_lt;
+
+static void smk_lights_update(void)
+{
+    uint32_t led = 0, i, rgb;
+    uint8_t lvl;
+    for (i = 0; i < NB; i++)
+        if (smk_lt.b >> i & 1u)
+            led |= 1u << SMK_BTN_OF_LABEL[i];
+    led &= ~(1u << SMK_B_PLAY);                               /* PLAY: B_PLAY its red half, LED_PLAY_GREEN its green */
+    if (smk_lt.b >> B_PLAY & 1u)
+        led |= 1u << SMK_LED_PLAY_RED;
+    if (smk_lt.b & LED_PLAY_GREEN)
+        led |= 1u << SMK_B_PLAY;
+    for (i = 0; i < SMK_NPAD; i++) {
+        uint32_t m = 1u << SMK_WHITE_K[i], r, g, b;
+        lvl = smk_lt.k & m ? 255u : smk_lt.la & m ? (uint8_t)(smk_lt.a8 * 255u / 8u) :
+              smk_lt.lb & m ? (uint8_t)(smk_lt.b8 * 255u / 8u) : smk_lt.mk & m ? 32u :
+              smk_lt.glow > 0 && (smk_lt.dk & m) ? 10u : 0u;
+        r = (SMK_PAD_RGB >> 16) * SMK_PAD_LIT * lvl / (255u * 255u);
+        g = (SMK_PAD_RGB >> 8 & 0xFFu) * SMK_PAD_LIT * lvl / (255u * 255u);
+        b = (SMK_PAD_RGB & 0xFFu) * SMK_PAD_LIT * lvl / (255u * 255u);
+        if (lvl && !(r | g | b))
+            r = g = 1u;                                       /* (the faintest still lit) */
+        rgb = r << 16 | g << 8 | b;
+        if (rgb != smk_pad_rgb[i])
+            smk_lights_dirty = 1;
+        smk_pad_rgb[i] = rgb;
+        smk_pad_lvl[i] = lvl;
+    }
+    if (led != smk_led_lit)
+        smk_lights_dirty |= 2u;
+    smk_led_lit = led;
+}
+
+/* plat.h's lights in (plat_smk37.c's plat_lights / _mid / _levels; the simulator's) */
+static void smk_lights_set(uint32_t buttons, uint32_t keys, uint32_t dim_buttons, uint32_t dim_keys, int glow)
+{
+    smk_lt.b = buttons;
+    smk_lt.k = keys;
+    smk_lt.db = dim_buttons & ~buttons;
+    smk_lt.dk = dim_keys & ~keys;
+    smk_lt.glow = glow;
+    smk_lights_update();
+}
+static void smk_lights_mid_set(uint32_t buttons, uint32_t keys)
+{
+    smk_lt.mb = buttons & ~smk_lt.b;
+    smk_lt.mk = keys & ~smk_lt.k;
+    smk_lights_update();
+}
+static void smk_lights_levels_set(uint32_t ka, uint32_t a8, uint32_t kb, uint32_t b8)
+{
+    smk_lt.la = ka & ~smk_lt.k;
+    smk_lt.lb = kb & ~smk_lt.k & ~ka;
+    smk_lt.a8 = (uint8_t)(a8 > 8u ? 8u : a8);
+    smk_lt.b8 = (uint8_t)(b8 > 8u ? 8u : b8);
+    smk_lights_update();
+}
