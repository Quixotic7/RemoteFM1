+/* SPDX-License-Identifier: MPL-2.0
+ * Copyright (C) 2026 RemoteFM1 contributors */
+/* lib/touch.h on the M-VAVE SMK-37 (BOARD_SMK37), in place of touch.c: every one of the 27 keys has its velocity, from
+ * the keybed key's two contacts or the pad that stands in for a white key (the platform's smk_panel.c: the last
+ * press's), and no pressure (the SMK's keys have none; the pads are keys here). Nothing to switch: the keys are read
+ * with their velocity whether this is on or not; on and off only say whether the app takes them from here.
+ * The host simulator's "key K down VEL": app_host_key, an FM-1 key held at VEL (beside the SMK's own controls). */
+
+static uint8_t tch_on;
+static uint32_t tch_keys, tch_prev;
+static uint8_t tch_vel[NKEYS];
+static uint32_t tch_host;                         /* the simulator's FM-1 keys (app_host_key) */
+static uint8_t tch_host_vel[NKEYS];
+static touch_ev_t tch_q[16];
+static uint8_t tch_qw, tch_qr;
+
+void touch_on(int on)
+{
+    tch_on = (uint8_t)(on != 0);
+    tch_prev = tch_keys;
+    tch_qr = tch_qw;
+}
+int touch_is_on(void) { return tch_on; }
+void touch_curve(int curve) { (void)curve; }      /* (the unit's factory curves: smk_decode.h) */
+void touch_sens(int sens) { (void)sens; }
+int touch_sensed(uint32_t key) { return key < NKEYS; }
+
+static uint8_t tch_vel_of(uint32_t k)
+{
+    return tch_host >> k & 1u ? tch_host_vel[k] : plat_smk_vel(k);
+}
+void touch_poll(void)
+{
+    uint32_t k, now = plat_keys() | tch_host, ch = now ^ tch_prev;
+    for (k = 0; ch && k < NKEYS; k++) {
+        if (!(ch >> k & 1u))
+            continue;
+        if (now >> k & 1u)
+            tch_vel[k] = tch_vel_of(k);
+        if ((uint8_t)(tch_qw - tch_qr) < 16u) {
+            touch_ev_t *e = &tch_q[tch_qw++ & 15u];
+            e->type = now >> k & 1u ? TOUCH_PRESS : TOUCH_RELEASE;
+            e->key = (uint8_t)k;
+            e->vel = tch_vel[k];
+        }
+    }
+    tch_prev = tch_keys = now;
+}
+int touch_take(touch_ev_t *e)
+{
+    if (tch_qr == tch_qw)
+        touch_poll();
+    if (tch_qr == tch_qw)
+        return 0;
+    *e = tch_q[tch_qr++ & 15u];
+    return 1;
+}
+void touch_update(void) {}
+uint32_t touch_keys(void) { return tch_keys; }
+uint8_t touch_vel(uint32_t key) { return key < NKEYS && tch_vel[key] ? tch_vel[key] : 100u; }
+uint8_t touch_vel_contact(uint32_t key) { return touch_vel(key); }
+uint8_t touch_pressure(uint32_t key) { (void)key; return 0; }
+int touch_down(uint32_t key) { return key < NKEYS && (tch_keys >> key & 1u); }
+
+/* the FM-1's scan hooks (lib/touch.h APP_KEY_SENSE): the SMK's scan has none */
+void app_key_sample(uint32_t key, uint32_t v, uint32_t ticks, int driven) { (void)key, (void)v, (void)ticks, (void)driven; }
+int app_key_drive(uint32_t key) { (void)key; return 0; }
+void app_key_probe(uint32_t key, uint32_t v, uint32_t pressed) { (void)key, (void)v, (void)pressed; }
+int app_key_led_ok(uint32_t key) { (void)key; return 1; }
+void app_host_key(uint32_t k, uint32_t vel, uint32_t press)
+{
+    (void)press;
+    if (k >= NKEYS)
+        return;
+    if (vel) {
+        tch_host |= 1u << k;
+        tch_host_vel[k] = (uint8_t)(vel > 127u ? 127u : vel);
+    } else {
+        tch_host &= ~(1u << k);
+    }
+}
+void app_host_tick(void) {}
