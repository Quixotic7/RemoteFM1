+++ b/device/smk_store.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: MPL-2.0
+ * Copyright (C) 2026 RemoteFM1 contributors */
+/* The M-VAVE SMK-37's flash, the app's side of it (BOARD_SMK37; plat.h): the same code on the device (unity.c, on
+ * felucca-bsp's driver) and in the host simulator (host/plat_host.c, on its simulated flash), through three hooks:
+ *   smk_fl_read(off, p, n)   smk_fl_erase(off)   smk_fl_write(off, p, n)   0 = done
+ *
+ *   the board      smk_board_seen: the unit's factory calibration record is there ("trimdat" at 0xC1224; every SMK-37
+ *                  has one: its stock firmware writes the defaults when it is missing). Without it this is not an
+ *                  SMK-37 (an FM-1 given this build by mistake): nothing of the app's is written, the owner tag is not
+ *                  looked at, and the update takes the FM-1's packages (felucca-bsp ota.c OTA_BOARD_ANY)
+ *   the marker     the stock firmware keeps its key / knob / fader mapping in USRFLASH (0xC2000..0xE9FFF) and trusts it
+ *                  while its end marker ("usrdata" at 0xEAFF8) stands. Before the app's first erase or write there the
+ *                  marker's sector (0xEA000) is erased, whole, never programmed: a return to the stock firmware then
+ *                  rebuilds its factory mapping instead of reading the app's data as it. Until then (no save that
+ *                  lands in USRFLASH) the stock mapping is kept as it was
+ *   the owner      at a start, the tag at PLAT_SMK_TAG ("SMK37DATA" + APP_SMK_FAMILY): another one (another
+ *                  firmware's, or none: the stock firmware's VM) and APP_SMK_CLEAR's windows are erased first (never
+ *                  USRFLASH: the stock mapping stays until the marker goes), then the tag written */
+
+static uint8_t smk_board_seen, smk_stock_gone;
+static uint32_t smk_stock_erases, smk_owner_clears;   /* (the simulator's checks) */
+static int smk_fl_read(uint32_t off, void *p, uint32_t n);
+static int smk_fl_erase(uint32_t off);
+static int smk_fl_write(uint32_t off, const void *p, uint32_t n);
+#define SMK_MARK_AT (PLAT_SMK_MARK + 0xFF8u)
+
+static int smk_hits(uint32_t off, uint32_t n, uint32_t lo, uint32_t hi)   /* [off, off + n) touches [lo, hi) */
+{
+    return off < hi && (off >= lo || n > lo - off);
+}
+
+/* before an erase or a write of the app's at [off, off + n): 0 = it may go on */
+static int smk_stock_release(uint32_t off, uint32_t n)
+{
+    uint8_t m[8];
+    uint32_t i, blank = 1;
+    if (!smk_board_seen)
+        return -1;
+    if (smk_stock_gone || !smk_hits(off, n, PLAT_XDATA1_LO, PLAT_XDATA1_HI))
+        return 0;
+    if (smk_fl_read(SMK_MARK_AT, m, 8))
+        return -1;
+    for (i = 0; i < 8u; i++)
+        blank &= m[i] == 0xFFu;
+    if (!blank) {
+        smk_stock_erases++;
+        if (smk_fl_erase(PLAT_SMK_MARK) || smk_fl_read(SMK_MARK_AT, m, 8))
+            return -1;
+        for (i = 0; i < 8u; i++)
+            if (m[i] != 0xFFu)
+                return -1;                    /* (not erased: nothing of the app's written there) */
+    }
