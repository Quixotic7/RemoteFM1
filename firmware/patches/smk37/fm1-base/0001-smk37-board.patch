+/* SPDX-License-Identifier: MPL-2.0
+ * Copyright (C) 2026 RemoteFM1 contributors */
+/* fm1-base on the M-VAVE SMK-37 (BOARD_SMK37): plat.h's panel on felucca-bsp's boards/smk37 scan, through
+ * smk_panel.c's map (shared with the host simulator); MASTER on K1; the battery from the analog muxes; the pads' lights
+ * sent between two panel transfers; the store's owner tag and the stock firmware's end marker (plat.h). Part of
+ * plat_fm1.c (the unity build), in place of the FM-1's panel and lights. */
+
+#include "smk_panel.c"
+
+static void smk_raw_get(smk_raw_t *r)              /* the scan's state, its interrupt held off a moment */
+{
+    uint32_t f = plat_lock(), i;
+    r->keys[0] = smk_in.keys.down[0];
+    r->keys[1] = smk_in.keys.down[1];
+    for (i = 0; i < SMK_NKEY; i++)
+        r->key_vel[i] = smk_in.keys.vel[i];
+    r->pads = smk_in.pads.down;
+    for (i = 0; i < SMK_NPAD; i++)
+        r->pad_vel[i] = smk_in.pads.vel[i];
+    r->btns = smk_in.btns.held;
+    r->fader_ok = 0;
+    for (i = 0; i < SMK_NFADER; i++) {
+        r->fader[i] = smk_in.faders.v[i];
+        if (smk_in.faders.seen[i])
+            r->fader_ok |= (uint8_t)(1u << i);
+    }
+    r->bend = smk_in.wheels.bend;
+    r->mod = smk_in.wheels.mod;
+    r->pedal = smk_in.pedal.down;
+    plat_unlock(f);
+}
+
+void plat_lights(uint32_t buttons, uint32_t keys, uint32_t dim_buttons, uint32_t dim_keys, int glow)
+{
+    smk_lights_set(buttons, keys, dim_buttons, dim_keys, glow);
+    {   /* the mirror's view, as on the FM-1: PLAY lit (either LED), and bit 15 PLAY lit red; the dim ones the same way */
+        uint32_t play = 1u << B_PLAY, lit = buttons & ((1u << NB) - 1u);
+        uint32_t db = glow > 0 ? dim_buttons : 0u, dk = glow > 0 ? dim_keys : 0u;
+        mirror_leds((lit & ~play) | (buttons & (play | LED_PLAY_GREEN) ? play : 0u) | (buttons & play ? 1u << 15 : 0u),
+                    keys, (db & ((1u << NB) - 1u) & ~play) | (db & (play | LED_PLAY_GREEN) ? play : 0u), dk);
+    }
+}
+void plat_lights_mid(uint32_t buttons, uint32_t keys)
+{
+    smk_lights_mid_set(buttons, keys);
+    mirror_mid(buttons & ((1u << NB) - 1u), keys);
+}
+void plat_lights_levels(uint32_t ka, uint32_t a8, uint32_t kb, uint32_t b8) { smk_lights_levels_set(ka, a8, kb, b8); }
+static uint8_t glow_on = 1, play_red;
+void plat_glow(int on) { glow_on = (uint8_t)(on != 0); }
+void plat_play_red(int red) { play_red = (uint8_t)(red != 0); }
+void plat_leds(uint32_t buttons, uint32_t keys)    /* as the FM-1's: PLAY green, unless red (recording); the glow */
+{
+    uint32_t play = 1u << B_PLAY, b = buttons, dim = glow_on ? ((1u << NB) - 1u) & ~buttons : 0u;
+    if (!play_red) {
+        b = (b & ~play) | (buttons & play ? LED_PLAY_GREEN : 0u);
+        dim = (dim & ~play) | (dim & play ? LED_PLAY_GREEN : 0u);
+    }
+    plat_lights(b, keys, dim, 0, glow_on ? 2 : 0);
+}
+
+uint32_t plat_buttons(void) { return smk_fm1_buttons(smk_in.btns.held) | remote.btn | mirror_in_buttons(); }
+
+uint32_t plat_keys(void)
+{
+    smk_panel_poll();
+    return (smk_fm1_keys() | remote.keys | mirror_in_keys()) & ((1u << NKEYS) - 1u);
+}
+static uint32_t plat_remote_keys(void) { return remote.keys; }
+static uint8_t plat_smk_vel(uint32_t k) { return smk_fm1_vel(k); }   /* lib/touch (touch_smk.c) */
+
+int32_t plat_enc(int role)
+{
+    int32_t r;
+    if (role < 0 || role >= NE)
+        return 0;
+    r = remote.enc[role];
+    remote.enc[role] = 0;
+    r += smk_enc_take(SMK_ENC_OF_ROLE[role]) + smk_panel_enc(role) + mirror_in_enc(role);
+    if (r)
+        mirror_enc(role, r);
+    return r;
+}
+
+static volatile uint32_t master_pos = 2896;   /* MASTER's position, 0..4096: K1's (half the level, m * m >> 12, at
+                                               * power-on), the remote's or the mirror's when they set it */
+static int32_t smk_master = 2896;
+uint32_t plat_master(void) { return master_pos; }
+static void smk_master_step(void)             /* (main loop) K1's detents into MASTER */
+{
+    int32_t d = smk_enc_take(SMK_ENC_MASTER);
+    if (d) {
+        smk_master += d * SMK_MASTER_STEP;
+        smk_master = smk_master < 0 ? 0 : smk_master > 4096 ? 4096 : smk_master;
+    }
+    master_pos = mirror_in_master(remote.master >= 0 ? (uint32_t)remote.master : (uint32_t)smk_master);
+}
+
+int plat_battery(void)                        /* mux C 7 (the stock firmware's levels); a USB host means power */
+{
+    if (usb.config && !usb.suspended)
+        return 4;
+    return smk_battery_bars(smk_in.batt >> 4);
+}
+
+void plat_sense(int on) { (void)on; }         /* (the SMK's keys are always read with their velocity) */
+uint32_t plat_analog_mask(void) { return (1u << NKEYS) - 1u; }
+
+/* the pads' frame, from the main loop: when a light changed, between two panel transfers (lcd.c: the last one over;
+ * never waits for one), ~0.6 ms with the LEDs' long reset; at most every 10 ms */
+static uint8_t smk_padbuf[SMK_PADLED_LEN] __attribute__((aligned(4)));
+static void smk_lights_step(void)
+{
+    static uint32_t last;
+    if (smk_lights_dirty & 2u) {              /* the button LEDs: the scan takes them at its next frame */
+        smk_led_on = smk_led_lit;
+        smk_lights_dirty &= (uint8_t)~2u;
+    }
+    if (!(smk_lights_dirty & 1u) || fm1_ms - last < 10u || !lcd_idle())
+        return;
+    lcd_sync();
+    smk_padled_frame(smk_padbuf, smk_pad_rgb);
+    if (!smk_padled_send(smk_padbuf, sizeof smk_padbuf))   /* (the scan's interrupt runs on: it has SPI2) */
+        smk_lights_dirty &= (uint8_t)~1u;
+    last = fm1_ms;
+}
