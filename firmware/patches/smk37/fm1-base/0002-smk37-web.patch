+#if BOARD_SMK37
+/* the M-VAVE SMK-37's panel (BOARD_SMK37): its controls as the simulator's "smk ..." commands set them, through the
+ * device's own map (device/smk_panel.c), and its lights read back. Keys 0..36 (0 = C3), pads 0..15 in reading order,
+ * buttons a mask of SMK_B_*, knobs 0..7 (K1 = MASTER); velocity 1..127, 0 = up */
+__attribute__((used, visibility("default"))) void web_smk_key(uint32_t k, uint32_t vel)
+{
+    if (k >= SMK_NKEY)
+        return;
+    if (vel) {
+        smk_sim.r.key_vel[k] = (uint8_t)(vel > 127u ? 127u : vel);
+        smk_sim.r.keys[k >> 5] |= 1u << (k & 31u);
+    } else {
+        smk_sim.r.keys[k >> 5] &= ~(1u << (k & 31u));
+    }
+}
+__attribute__((used, visibility("default"))) void web_smk_pad(uint32_t p, uint32_t vel)
+{
+    if (p >= SMK_NPAD)
+        return;
+    if (vel)
+        smk_sim.r.pad_vel[p] = (uint8_t)(vel > 127u ? 127u : vel);
+    smk_sim.r.pads = (uint16_t)(vel ? smk_sim.r.pads | 1u << p : smk_sim.r.pads & ~(1u << p));
+}
+__attribute__((used, visibility("default"))) void web_smk_buttons(uint32_t m) { smk_sim.r.btns = m & ((1u << SMK_NBTN) - 1u); }
+__attribute__((used, visibility("default"))) void web_smk_enc(uint32_t e, int32_t n)
+{
+    if (e == SMK_ENC_MASTER) {
+        int32_t m = (int32_t)master + n * SMK_MASTER_STEP;
+        master = (uint32_t)(m < 0 ? 0 : m > 4096 ? 4096 : m);
+    } else if (e < SMK_NENC) {
+        smk_sim.enc[e] += n;
+    }
+}
+__attribute__((used, visibility("default"))) void web_smk_fader(uint32_t f, uint32_t v)
+{
+    if (f < SMK_NFADER)
+        smk_sim.r.fader[f] = (uint8_t)(v > 127u ? 127u : v);
+}
+__attribute__((used, visibility("default"))) void web_smk_bend(int32_t v) { smk_sim.r.bend = (int16_t)(v < -8192 ? -8192 : v > 8191 ? 8191 : v); }
+__attribute__((used, visibility("default"))) void web_smk_mod(uint32_t v) { smk_sim.r.mod = (uint8_t)(v > 127u ? 127u : v); }
+__attribute__((used, visibility("default"))) void web_smk_pedal(uint32_t on) { smk_sim.r.pedal = (uint8_t)(on != 0); }
+/* the lights: bit i LED i (SMK_B_*; bit 18 SEQ PLAY's red half), each pad's 0xRRGGBB as the LED chain gets it and its
+ * level 0..255 of lit */
+__attribute__((used, visibility("default"))) uint32_t web_smk_leds(void) { return smk_led_lit; }
+__attribute__((used, visibility("default"))) uint32_t *web_smk_pad_rgb(void) { return smk_pad_rgb; }
+__attribute__((used, visibility("default"))) uint8_t *web_smk_pad_lvl(void) { return smk_pad_lvl; }
+__attribute__((used, visibility("default"))) uint32_t web_smk_master(void) { return master; }
+
+#ifdef RF_SX_ID0
+/* RemoteFM1's USB SysEx link, for a host on the page's side (RemoteFM1.com's player through a relay): the page writes
+ * the host's SysEx bytes (any slice of the stream, at most web_usx_room() of them) to web_usx_in_buf and calls
+ * web_usx_in(n); they go through usb.c's tap as the simulator's "rf send usb" has them. What the app sends on USB
+ * SysEx comes back as whole F0 .. F7 messages from web_usx_out_buf (web_usx_out_len bytes; web_usx_out_clear when
+ * read). The simulated host's parser still sees them (rfm_host.c hs_msg) */
+#define USX_OUT 262144u
+static uint8_t usx_in[4096], usx_out[USX_OUT];
+static uint32_t usx_n, usx_drops;
+static void usx_msg(void *ctx, uint32_t cmd, const uint8_t *b, uint32_t len)
+{
+    if (usx_n + rf_packed_len(len) + 6u <= USX_OUT)
+        usx_n += rf_sx_encode(cmd, b, len, usx_out + usx_n);
+    else
+        usx_drops++;
+    hs_msg(ctx, cmd, b, len);
+}
+static void usx_hook(void) { hs_sx[0].b.fn = usx_msg; }   /* (hs_init sets it again at each boot) */
+__attribute__((used, visibility("default"))) uint8_t *web_usx_in_buf(void) { return usx_in; }
+__attribute__((used, visibility("default"))) uint32_t web_usx_room(void)
+{
+    uint32_t free_ = RF_MRX_N - (mrx_w - mrx_r);
+    free_ = free_ > 64u ? free_ - 64u : 0u;                 /* (usb.c holds EP1 below 64) */
+    return free_ < sizeof usx_in ? free_ : (uint32_t)sizeof usx_in;
+}
+__attribute__((used, visibility("default"))) void web_usx_in(uint32_t n)
+{
+    uint32_t i;
+    usx_hook();
+    for (i = 0; i < n && i < sizeof usx_in; i++)
+        hu_byte(usx_in[i]);
+}
+__attribute__((used, visibility("default"))) uint8_t *web_usx_out_buf(void) { return usx_out; }
+__attribute__((used, visibility("default"))) uint32_t web_usx_out_len(void) { usx_hook(); return usx_n; }
+__attribute__((used, visibility("default"))) void web_usx_out_clear(void) { usx_n = 0; }
+__attribute__((used, visibility("default"))) uint32_t web_usx_drops(void) { return usx_drops; }
+#endif
+#endif
+
